# TeleBook Local Development Environment Variables
# Copy to .dev.vars for local wrangler development (DO NOT COMMIT .dev.vars)

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Owner Telegram User ID (numeric, from @userinfobot)
OWNER_TELEGRAM_ID="123456789"

# Webhook secret verified against X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET="local-webhook-secret-token"

# JWT secret key for session verification (min 32 chars)
JWT_SECRET="local-development-secret-key-at-least-32-chars-long"

# Application URL
APP_URL="http://localhost:5173"

# Telegram Bot Username (without @)
BOT_USERNAME="TeleBookBot"
