# TeleBook Cloudflare Worker Configuration
name = "telebook-worker"
main = "src/index.ts"
compatibility_date = "2024-11-12"
compatibility_flags = ["nodejs_compat"]

# Cloudflare D1 Database Binding
[[d1_databases]]
binding = "DB"
database_name = "telebook-db"
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"

# Public Environment Variables (Non-sensitive)
[vars]
BOT_USERNAME = "TeleBookBot"
APP_URL = "https://telebook.pages.dev"

# Secrets required in production (Set via `wrangler secret put <KEY>`):
# - TELEGRAM_BOT_TOKEN: Your Telegram bot API token from @BotFather
# - OWNER_TELEGRAM_ID: Your numeric Telegram user ID
# - TELEGRAM_WEBHOOK_SECRET: Secret token for X-Telegram-Bot-Api-Secret-Token validation
# - JWT_SECRET: 32+ character cryptographically secure secret for signing session tokens
