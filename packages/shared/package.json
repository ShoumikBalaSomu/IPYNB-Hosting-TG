{
  "name": "@telebook/shared",
  "version": "1.0.0",
  "description": "TeleBook isomorphic shared library: TELEBOOK_V1 crypto, nbformat models, and chunking protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js",
      "default": "./dist/crypto/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js",
      "default": "./dist/models/index.js"
    },
    "./chunking": {
      "types": "./dist/chunking/index.d.ts",
      "import": "./dist/chunking/index.js",
      "default": "./dist/chunking/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser/index.js",
      "default": "./dist/parser/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/tests/**/*.test.js"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^7.0.2"
  }
}
